# Copy this file to `.env` and fill in values to enable optional AI coaching.
# The app works fully WITHOUT this key — local geometry analysis is always on.

# Optional: enables Claude-vision posing/physique coaching.
# When set, analyzed photos are sent to Anthropic for that request only.
ANTHROPIC_API_KEY=

# Vision-capable model. Falls back automatically if unavailable.
AI_MODEL=claude-opus-4-8

# API port (Vite dev server proxies /api here). Defaults to 8787.
API_PORT=8787

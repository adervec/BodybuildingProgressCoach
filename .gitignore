# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
build/
*.tsbuildinfo

# vendored MediaPipe assets (provisioned at build: WASM copied from node_modules,
# pose model downloaded once). Served locally so the app makes no third-party calls.
client/public/mediapipe/
# Copied from "Associated Guide/" at build time (provision-guides.mjs) — one source of truth.
client/public/guides/

# app data (media + sqlite live here) — ignore contents but keep the dir
server/data/*
!server/data/.gitkeep

# env / secrets
.env
.env.local
*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db
